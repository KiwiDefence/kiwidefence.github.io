# Public site URL used for metadata, sitemap, and robots.txt
SITE_URL=https://kiwidefence.com

# Kiwi Scanner product URL (linked from /services)
NEXT_PUBLIC_KIWISCANNER_URL=https://scanner.kiwidefence.com

# Contact phone shown on /contact and in structured data (leave empty to hide)
NEXT_PUBLIC_CONTACT_PHONE=

# Form endpoint (e.g. Formspree/Basin URL). If empty, forms fall back to a mailto: draft.
NEXT_PUBLIC_FORM_ENDPOINT=

# Host port when running via docker compose
PORT=3000
